# Database connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/trim_dev?schema=public"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/trim_test?schema=public"

# Application secret for session cookies / JWT signing
APP_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
NODE_ENV="production"
PORT=3000

# Optional AI Provider configuration (provider-agnostic: mock, openai, gemini)
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

